{
  "name": "tudu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next test-results playwright-report tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:postgres": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://tudu:tudu@localhost:5433/tudu_test} vitest run src/features/tasks/server",
    "test:e2e:postgres": "TUDU_E2E_DATABASE_URL=${TUDU_E2E_DATABASE_URL:-postgres://tudu:tudu@localhost:5433/tudu_test} playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "next": "^16.4.6",
    "openai": "^7.58.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
