# Optional. Configure a provider key on the server, then select it in Settings.
# Without a selected provider's key, the app works as a regular to-do list.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional provider defaults for capture and work-log summaries.
# A model saved in Settings overrides the selected provider's default.
# TUDU_AI_MODEL=claude-opus-5-5
# TUDU_OPENAI_MODEL=gpt-6.2-sol
# TUDU_OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Optional. Store tasks in PostgreSQL instead of data/tasks.json.
# With Docker, start the database with: docker compose --profile postgres up --build
# A new database starts with the tasks already in data/tasks.json (the file is not changed).
# DATABASE_URL=postgres://tudu:tudu@db:5432/tudu

# Optional. Enables local HTTP MCP at /api/mcp. Use 32-256 letters, digits, _ or -.
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# TUDU_MCP_TOKEN=
